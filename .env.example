# Copie este arquivo para .env e ajuste os valores. O .env NÃO deve ser versionado.

# --- Banco de dados (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oficina
DB_USER=oficina
DB_PASSWORD=change-me

# --- Aplicação ---
APP_PORT=8080

# --- Autenticação JWT (APIs administrativas) ---
# JWT_SECRET: chave de assinatura HS256, com no mínimo 32 caracteres. Troque fora do ambiente de demonstração.
JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
JWT_EXPIRACAO_MINUTOS=60
# Usuários de demonstração (usados em POST /autenticacao/login).
# ADMIN acessa todas as APIs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# CLIENTE fica vinculado a um CPF/CNPJ válido e só acessa recursos desse documento.
CLIENTE_USERNAME=cliente
CLIENTE_PASSWORD=cliente123
CLIENTE_DOCUMENTO=52998224725
